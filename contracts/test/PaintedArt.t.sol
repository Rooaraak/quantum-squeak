pragma solidity 0.8.26;

import {Test, console2} from "forge-std/Test.sol";
import {PaintedArt} from "../src/PaintedArt.sol";
// ---- generated by tools/pack_art.py from wheel/art/art.json: do not edit by hand ----
import {ArtChunk00} from "../src/ArtChunk00.sol";
import {ArtChunk01} from "../src/ArtChunk01.sol";
import {ArtChunk02} from "../src/ArtChunk02.sol";
import {ArtChunk03} from "../src/ArtChunk03.sol";
import {ArtChunk04} from "../src/ArtChunk04.sol";
import {ArtChunk05} from "../src/ArtChunk05.sol";
import {ArtChunk06} from "../src/ArtChunk06.sol";
import {ArtChunk07} from "../src/ArtChunk07.sol";
import {ArtChunk08} from "../src/ArtChunk08.sol";
import {ArtChunk09} from "../src/ArtChunk09.sol";
import {ArtChunk10} from "../src/ArtChunk10.sol";
import {ArtChunk11} from "../src/ArtChunk11.sol";
import {ArtChunk12} from "../src/ArtChunk12.sol";
import {ArtChunk13} from "../src/ArtChunk13.sol";
import {ArtChunk14} from "../src/ArtChunk14.sol";
// ---- end of generated block ----

/// PaintedArt against the reference renderer in tools/pack_art.py (test/data/art-expected.json): every chunk's runtime,
/// every sprite read back through the chunk-spanning copy, and hamster(looks, tier) byte for byte (sha256 + length) for
/// all 16 looks x tiers 0..5.
contract PaintedArtTest is Test {
    PaintedArt internal art;
    address[] internal chunkList;
    string internal json;

    function setUp() public {
        chunkList = _deployChunks();
        art = new PaintedArt(chunkList);
        json = vm.readFile("test/data/art-expected.json");
    }

    function _deployChunks() internal returns (address[] memory chunks) {
        // ---- generated by tools/pack_art.py from wheel/art/art.json: do not edit by hand ----
        chunks = new address[](15);
        chunks[0] = address(new ArtChunk00());
        chunks[1] = address(new ArtChunk01());
        chunks[2] = address(new ArtChunk02());
        chunks[3] = address(new ArtChunk03());
        chunks[4] = address(new ArtChunk04());
        chunks[5] = address(new ArtChunk05());
        chunks[6] = address(new ArtChunk06());
        chunks[7] = address(new ArtChunk07());
        chunks[8] = address(new ArtChunk08());
        chunks[9] = address(new ArtChunk09());
        chunks[10] = address(new ArtChunk10());
        chunks[11] = address(new ArtChunk11());
        chunks[12] = address(new ArtChunk12());
        chunks[13] = address(new ArtChunk13());
        chunks[14] = address(new ArtChunk14());
        // ---- end of generated block ----
    }

    // ---------------------------------------------------------------- data contracts

    function test_chunks_are_the_packed_stream() public view {
        bytes32[] memory h = vm.parseJsonBytes32Array(json, ".chunkCodehash");
        uint256 chunkBytes = vm.parseJsonUint(json, ".chunkBytes");
        uint256 streamLength = vm.parseJsonUint(json, ".streamLength");
        assertEq(h.length, art.CHUNKS());
        assertEq(chunkBytes, art.CHUNK_BYTES());
        address[] memory got = art.chunks();
        assertEq(got.length, h.length);
        uint256 total;
        for (uint256 k = 0; k < got.length; k++) {
            assertEq(got[k], chunkList[k]);
            assertEq(got[k].codehash, h[k], "chunk codehash");
            uint256 size = got[k].code.length;
            assertLe(size, 24576, "EIP-170");
            assertEq(uint8(got[k].code[0]), 0, "first byte STOP: never callable");
            if (k + 1 < got.length) assertEq(size, chunkBytes + 1, "every chunk but the last is full");
            total += size - 1;
        }
        assertEq(total, streamLength);
    }

    function test_chunks_cannot_be_called() public {
        (bool ok, bytes memory ret) = chunkList[0].call(hex"12345678");
        assertTrue(ok); // STOP: succeeds and does nothing
        assertEq(ret.length, 0);
    }

    function test_every_asset_reads_back() public view {
        bytes32[] memory sha = vm.parseJsonBytes32Array(json, ".assetSha");
        uint256[] memory len = vm.parseJsonUintArray(json, ".assetLen");
        assertEq(sha.length, art.ASSETS());
        bool spans;
        for (uint256 i = 0; i < sha.length; i++) {
            bytes memory a = bytes(art.asset(i));
            assertEq(a.length, len[i], "asset length");
            assertEq(sha256(a), sha[i], "asset bytes");
            (uint256 start, uint256 n) = art.assetSpan(i);
            assertEq(n, len[i]);
            if (start / art.CHUNK_BYTES() != (start + n - 1) / art.CHUNK_BYTES()) spans = true;
        }
        assertTrue(spans, "some asset spans two chunks (the copy across a boundary is tested)");
    }

    // ---------------------------------------------------------------- hamster()

    function test_every_look_and_tier_is_the_reference_svg() public view {
        bytes32[] memory sha = vm.parseJsonBytes32Array(json, ".svgSha");
        uint256[] memory len = vm.parseJsonUintArray(json, ".svgLen");
        assertEq(sha.length, 96);
        for (uint8 looks = 0; looks < 16; looks++) {
            for (uint8 tier = 0; tier <= 5; tier++) {
                bytes memory s = bytes(art.hamster(looks, tier));
                uint256 i = uint256(looks) * 6 + tier;
                assertEq(s.length, len[i], "svg length");
                assertEq(sha256(s), sha[i], string.concat("svg bytes, looks ", vm.toString(looks), " tier ", vm.toString(tier)));
            }
        }
    }

    function test_fragment_shape() public view {
        bytes memory head = "<g><image width='448' height='600' href='data:image/webp;base64,UklG";
        bytes memory plain = bytes(art.hamster(0, 1));
        assertEq(_slice(plain, 0, head.length), head);
        assertEq(_slice(plain, plain.length - 7, 7), "'/></g>");
        bytes memory dressed = bytes(art.hamster(7, 5));
        assertEq(_slice(dressed, 0, 19), "<g><mask id='qh7_5'");
        assertEq(_slice(dressed, dressed.length - 4, 4), "</g>");
        bytes memory fifteen = bytes(art.hamster(15, 4));
        assertEq(_slice(fifteen, 0, 20), "<g><mask id='qh15_4'");
    }

    function test_rejects_bad_looks_and_tier() public {
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.LooksOutOfRange.selector, uint8(16)));
        art.hamster(16, 1);
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.TierOutOfRange.selector, uint8(6)));
        art.hamster(0, 6);
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.AssetOutOfRange.selector, uint256(19)));
        art.asset(19);
    }

    function test_tier_zero_is_the_plain_body_like_common() public view {
        // same layers as Common (the page's not-caught look); only the mask id differs when an item is worn
        assertEq(art.hamster(0, 0), art.hamster(0, 1));
        assertEq(art.hamster(8, 0), art.hamster(8, 1));
        assertTrue(keccak256(bytes(art.hamster(7, 0))) != keccak256(bytes(art.hamster(7, 1))));
        assertEq(bytes(art.hamster(7, 0)).length, bytes(art.hamster(7, 1)).length);
    }

    // ---------------------------------------------------------------- constructor checks

    function test_constructor_rejects_wrong_chunks() public {
        address[] memory c = new address[](chunkList.length);
        for (uint256 k = 0; k < c.length; k++) {
            c[k] = chunkList[k];
        }
        (c[0], c[1]) = (c[1], c[0]);
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.WrongChunk.selector, uint256(0), c[0]));
        new PaintedArt(c);

        (c[0], c[1]) = (c[1], c[0]);
        c[c.length - 1] = address(this);
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.WrongChunk.selector, c.length - 1, address(this)));
        new PaintedArt(c);

        address[] memory short = new address[](c.length - 1);
        vm.expectRevert(abi.encodeWithSelector(PaintedArt.WrongChunkCount.selector, c.length - 1));
        new PaintedArt(short);
    }

    // ---------------------------------------------------------------- gas
    // Execution cost of the external call inside the test tx (cold chunks, no 21k base), one call per test so the
    // caller's memory starts empty each time (the returned string is copied into it). Anvil eth_estimateGas numbers are
    // in the commit notes.

    function test_gas_hamster_gold_all_items() public view {
        _gas(7, 5, "hamster(7, 5): gold, hat + glasses + scarf, calm");
    }

    function test_gas_hamster_heaviest() public view {
        // circuit skin (Rare) is the biggest body: looks 15 tier 3 is the longest fragment of all
        assertEq(vm.parseJsonUint(json, ".heaviest.looks"), 15);
        assertEq(vm.parseJsonUint(json, ".heaviest.tier"), 3);
        _gas(15, 3, "hamster(15, 3): circuit, all items, grin (longest)");
    }

    function test_gas_hamster_plain() public view {
        _gas(0, 1, "hamster(0, 1): plain Common");
    }

    function _gas(uint8 looks, uint8 tier, string memory what) internal view {
        uint256 g = gasleft();
        string memory s = art.hamster(looks, tier);
        g -= gasleft();
        console2.log(what);
        console2.log("  gas", g, "bytes", bytes(s).length);
    }

    function _slice(bytes memory b, uint256 from, uint256 n) internal pure returns (bytes memory r) {
        r = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            r[i] = b[from + i];
        }
    }
}
