pragma solidity 0.8.26;

import {CatchLib} from "./CatchLib.sol";
import {Card, Dna, IS2Renderer} from "./S2Types.sol";
import {S2Text} from "./S2Text.sol";

/// @title Quantum Catch Season 2 renderer (the launch art)
/// @notice Turns a net's numbers and raw DNA (QuantumCatchV3) into its metadata and picture, fully on-chain. The game's
///         owner can replace this contract until it locks the game; nothing here can change a draw.
/// @dev THE LOOKS RULE (how the raw draw becomes a hamster; tools/pack_s2.py holds the reference this contract must
///      match byte for byte):
///      - skin = SKINS[tier][(w0 / shots) % len] (w0 = the main draw's word; the lists are in the directory).
///      - slot k with drawn tier t and word w: t <= 1 (Common or chip noise) -> the default (0). Else the list of tier t;
///        HALF_CRAZY: an Epic shot (t = 4) uses the Rare list when the top bit of w is 0; a Legendary shot with an empty
///        Legendary list uses the Epic list; an empty list -> the default. item = list[(w / shots) % len]; its tier is
///        the list it is in (ids 1..n per slot in list order Uncommon, Rare, Epic, Legendary).
///      - precedence, in this order: (1) a face not painted for the skin shows honey (0); (2) a HELMET head item is not
///        worn on a WIDE face (head 0); (3) a BOX special stays iff its tier >= the shown Neck and Hands items' tiers
///        (then Neck = Hands = 0), else the box goes (Special 0).
///      THE PICTURE: Season 1's card (tier colour, the ring, the caption) with, in the painted box, back to front: the
///      background (clipped round), the aura, the skin x face sprite cut by the worn items' erase layers (a luminance
///      mask), the aura's front half (FRONT auras only), then the items: back, special, neck, hands, mouth, eyes, head.
///      THE FORMAT (PRE2): "data:application/json;base64," + base64 of the JSON, whose image is "data:image/svg+xml;
///      base64," + base64 of the SVG. Every sprite is stored as base64(base64(its whole <image .../> element padded with
///      spaces to a multiple of 9 bytes)); the JSON head is padded to a multiple of 3 and every other SVG piece to a
///      multiple of 9, so both base64 passes split at every piece and stored elements are only copied, never encoded.
///      The data contracts (the art chunks, the directory) are checked by code hash in the constructor; no owner, no
///      setters, no storage written after it.
contract S2Renderer is IS2Renderer {
    error WrongDirectory(address directory);
    error WrongChunkCount(uint256 count);
    error WrongChunk(uint256 k, address chunk);
    error TextHasNoCode(address text);
    error ElementOutOfRange(uint256 id);
    error SlotOutOfRange(uint256 slot);
    error IdOutOfRange(uint256 id);

    /// @notice an Epic shot shows a Rare-list item when the top bit of its word is 0 (the owner's half-crazy, D4)
    bool public constant HALF_CRAZY = true;

    uint256 internal constant NONE = 0xFFFF;
    uint256 internal constant DYN = 0xFFFF;
    uint256 internal constant MAXSEG = 40;
    uint8 internal constant HELMET = 1;
    uint8 internal constant WIDE = 2;
    uint8 internal constant BOX = 4;
    uint8 internal constant FRONT = 8;

    // ---- generated by tools/pack_s2.py from contracts/art/s2/sprites.json: do not edit by hand ----
    /// @notice data contracts holding the PRE2 element stream (2,861,296 bytes at most)
    uint256 public constant CHUNKS = 117;
    /// @notice stream bytes per data contract (its runtime is an INVALID byte, 0xfe, and then these)
    uint256 public constant CHUNK_BYTES = 24575;
    /// @notice stored elements (sprites)
    uint256 public constant ELEMENTS = 214;
    /// @notice keccak256 of the directory's runtime code (0xfe + its bytes), checked by the constructor
    bytes32 public constant DIRECTORY_CODEHASH = 0xbcabacbf9c37d3dac10dc806f6598464a7d8bff906ad2ade22fbcf2f84d991d5;
    uint256 internal constant DIR_BYTES = 6914;
    uint256 internal constant OFF_REC = 3744; // u24 start, u24 length per element
    uint256 internal constant OFF_SF = 5028; // u16 element per skin x face (11 x 9), 0xFFFF = not painted
    uint256 internal constant OFF_SKT = 5226; // per tier 1..5: u8 n, u8 skin ids [3]
    uint256 internal constant OFF_SLOT = 5246; // per slot 1..10: u8 nU, nR, nE, nL, u16 first item
    uint256 internal constant OFF_ITEM = 5306; // per item: u16 element, u16 erase, u8 flags, u16 name start, u8 name length
    uint256 internal constant OFF_SKIN = 5978; // per skin: u16 name start, u8 name length, then 7 bytes of fur colour
    uint256 internal constant OFF_NAMES = 6088; // the names, UTF-8
    // ---- end of generated block ----

    /// @notice the directory data contract (chunk code hashes, element records, trait tables, names)
    address public immutable DIRECTORY;
    /// @notice the words and the card frame
    S2Text public immutable TEXT;
    address[] private _chunks;

    /// @param directory the S2Directory data contract
    /// @param chunks_ the S2Art00 .. S2ArtNN data contracts, in order
    /// @param text the S2Text contract
    constructor(address directory, address[] memory chunks_, S2Text text) {
        if (directory.codehash != DIRECTORY_CODEHASH) revert WrongDirectory(directory);
        if (chunks_.length != CHUNKS) revert WrongChunkCount(chunks_.length);
        if (address(text).code.length == 0) revert TextHasNoCode(address(text));
        bytes memory d = _readDir(directory);
        for (uint256 k; k < CHUNKS; ++k) {
            address a = chunks_[k];
            bytes32 want;
            assembly ("memory-safe") {
                want := mload(add(add(d, 0x20), shl(5, k)))
            }
            if (a.codehash != want) revert WrongChunk(k, a);
            _chunks.push(a);
        }
        DIRECTORY = directory;
        TEXT = text;
    }

    // ------------------------------------------------------------------ public

    /// @inheritdoc IS2Renderer
    function tokenURI(Card calldata c, Dna calldata d) external view returns (string memory) {
        bytes memory dir = _readDir(DIRECTORY);
        Seg memory o;
        bytes memory head;
        if (c.status == 1) {
            (uint8 skin, uint8[10] memory items, uint8[10] memory itemTiers) = _looks(d, dir);
            itemTiers; // the tiers only decide precedence (done)
            (string memory skinS, string[10] memory traits, uint256 worn) = _names(dir, skin, items);
            head = TEXT.head(c, d, skinS, traits, worn);
            (bytes memory open, bytes memory tail) = TEXT.frame(c, _fur(dir, skin));
            _paint(o, dir, skin, items, open, tail);
        } else {
            string[10] memory none;
            head = TEXT.head(c, d, "", none, 0);
            _dyn(o, TEXT.plain(c));
        }
        _ret(_assemble(o, dir, head));
    }

    /// @inheritdoc IS2Renderer
    function itemsOf(Dna calldata d) external view returns (uint8 skin, uint8[10] memory items) {
        (skin, items,) = _looks(d, _readDir(DIRECTORY));
    }

    /// @notice the looks with each shown item's tier (the list it came from; 0 for a default)
    function looksOf(Dna calldata d) external view returns (uint8 skin, uint8[10] memory items, uint8[10] memory tiers) {
        return _looks(d, _readDir(DIRECTORY));
    }

    /// @notice the name of item `id` of slot `slot` (1 Face .. 10 Background); id 0 = the slot's default
    function traitName(uint8 slot, uint8 id) external view returns (string memory) {
        bytes memory dir = _readDir(DIRECTORY);
        if (slot < 1 || slot > 10) revert SlotOutOfRange(slot);
        if (id == 0) return slot == 1 ? "Honey" : "None";
        return string(_itemName(dir, _itemIndex(dir, slot, id)));
    }

    /// @notice the tier of item `id` of slot `slot`: the list it is in (2 Uncommon .. 5 Legendary); 0 for the default
    function traitTier(uint8 slot, uint8 id) external view returns (uint8) {
        bytes memory dir = _readDir(DIRECTORY);
        if (slot < 1 || slot > 10) revert SlotOutOfRange(slot);
        if (id == 0) return 0;
        _itemIndex(dir, slot, id);
        (uint256 nU, uint256 nR, uint256 nE,,) = _slot(dir, slot);
        if (id <= nU) return 2;
        if (id <= nU + nR) return 3;
        if (id <= nU + nR + nE) return 4;
        return 5;
    }

    /// @notice how many items slot `slot` has per list (Uncommon, Rare, Epic, Legendary)
    function listLengths(uint8 slot) external view returns (uint8 nU, uint8 nR, uint8 nE, uint8 nL) {
        if (slot < 1 || slot > 10) revert SlotOutOfRange(slot);
        (uint256 u, uint256 r, uint256 e, uint256 l,) = _slot(_readDir(DIRECTORY), slot);
        return (uint8(u), uint8(r), uint8(e), uint8(l));
    }

    /// @notice the name of skin `id` (0 Plain .. 10 Rainbow)
    function skinName(uint8 id) external view returns (string memory) {
        if (id > 10) revert IdOutOfRange(id);
        bytes memory dir = _readDir(DIRECTORY);
        uint256 at = OFF_SKIN + uint256(id) * 10;
        return string(_slice(dir, OFF_NAMES + _u16(dir, at), _u8(dir, at + 2)));
    }

    /// @notice whether skin `skin` has face `face` painted (else the honey face shows)
    function facePainted(uint8 skin, uint8 face) external view returns (bool) {
        if (skin > 10 || face > 8) revert IdOutOfRange(skin > 10 ? skin : face);
        return _u16(_readDir(DIRECTORY), OFF_SF + (uint256(skin) * 9 + face) * 2) != NONE;
    }

    /// @notice one element's stored bytes: base64(base64(its <image .../> element, space-padded to 9 | length))
    function asset(uint256 id) external view returns (bytes memory b) {
        bytes memory dir = _readDir(DIRECTORY);
        (uint256 start, uint256 n) = _rec(dir, id);
        b = new bytes(n);
        uint256 p;
        assembly ("memory-safe") {
            p := add(b, 0x20)
        }
        _copy(p, start, n);
    }

    /// @notice the art data contracts, in stream order
    function chunks() external view returns (address[] memory) {
        return _chunks;
    }

    // ------------------------------------------------------------------ the looks

    function _looks(Dna calldata d, bytes memory dir)
        internal
        pure
        returns (uint8 skin, uint8[10] memory items, uint8[10] memory tiers)
    {
        if (d.status != 1 || d.tier < 1 || d.tier > 5 || d.shots == 0) return (skin, items, tiers);
        uint256 shots = d.shots;
        {
            uint256 at = OFF_SKT + (uint256(d.tier) - 1) * 4;
            skin = uint8(_u8(dir, at + 1 + (uint256(d.word) / shots) % _u8(dir, at)));
        }
        for (uint256 k = 1; k <= 10; ++k) {
            uint256 t = d.tiers[k - 1];
            if (t <= 1 || t > 5) continue;
            uint256 w = uint256(d.words[k - 1]);
            if (HALF_CRAZY && t == 4 && w >> 255 == 0) t = 3;
            (uint256 nU, uint256 nR, uint256 nE, uint256 nL,) = _slot(dir, k);
            if (t == 5 && nL == 0) t = 4;
            uint256 n = t == 2 ? nU : t == 3 ? nR : t == 4 ? nE : nL;
            if (n == 0) continue;
            uint256 base = t == 2 ? 0 : t == 3 ? nU : t == 4 ? nU + nR : nU + nR + nE;
            items[k - 1] = uint8(base + (w / shots) % n + 1);
            tiers[k - 1] = uint8(t);
        }
        // (1) the face must be painted for this skin
        if (items[0] != 0 && _u16(dir, OFF_SF + (uint256(skin) * 9 + items[0]) * 2) == NONE) {
            items[0] = 0;
            tiers[0] = 0;
        }
        // (2) no helmet on wide cheeks
        if (
            items[1] != 0 && items[0] != 0 && _flags(dir, 2, items[1]) & HELMET != 0
                && _flags(dir, 1, items[0]) & WIDE != 0
        ) {
            items[1] = 0;
            tiers[1] = 0;
        }
        // (3) the box hides neck and hands, or goes
        if (items[7] != 0 && _flags(dir, 8, items[7]) & BOX != 0) {
            if (tiers[7] >= tiers[4] && tiers[7] >= tiers[5]) {
                items[4] = 0;
                tiers[4] = 0;
                items[5] = 0;
                tiers[5] = 0;
            } else {
                items[7] = 0;
                tiers[7] = 0;
            }
        }
    }

    function _names(bytes memory dir, uint8 skin, uint8[10] memory items)
        internal
        pure
        returns (string memory skinS, string[10] memory traits, uint256 worn)
    {
        uint256 at = OFF_SKIN + uint256(skin) * 10;
        skinS = string(_slice(dir, OFF_NAMES + _u16(dir, at), _u8(dir, at + 2)));
        for (uint256 k = 1; k <= 10; ++k) {
            uint256 id = items[k - 1];
            if (id == 0) {
                traits[k - 1] = k == 1 ? "Honey" : "None";
            } else {
                traits[k - 1] = string(_itemName(dir, _itemIndex(dir, k, id)));
                ++worn;
            }
        }
    }

    function _fur(bytes memory dir, uint8 skin) internal pure returns (string memory) {
        return string(_slice(dir, OFF_SKIN + uint256(skin) * 10 + 3, 7));
    }

    // ------------------------------------------------------------------ the picture

    /// one piece of the output: dynamic text (id DYN, raw bytes) or a stored element (its id)
    struct Seg {
        bytes[MAXSEG] raw;
        uint256[MAXSEG] id;
        uint256 n;
    }

    function _dyn(Seg memory o, bytes memory b) internal pure {
        if (o.n != 0 && o.id[o.n - 1] == DYN) {
            o.raw[o.n - 1] = abi.encodePacked(o.raw[o.n - 1], b);
        } else {
            o.raw[o.n] = b;
            o.id[o.n] = DYN;
            ++o.n;
        }
    }

    function _put(Seg memory o, uint256 element) internal pure {
        o.id[o.n] = element;
        ++o.n;
    }

    string internal constant PAINTED_OPEN = "<g id='painted' transform='translate(70.4 8.4) scale(.8)'>";
    string internal constant BG_OPEN =
        "<clipPath id='p'><circle cx='112' cy='147' r='112'/></clipPath><g clip-path='url(#p)'>";
    string internal constant MASK_OPEN = "<mask id='m' maskUnits='userSpaceOnUse' maskContentUnits='userSpaceOnUse' "
        "x='0' y='0' width='224' height='300' color-interpolation='sRGB'><rect width='224' height='300' fill='#fff'/>";
    string internal constant FRONT_CLIP = "<clipPath id='f'><rect y='156' width='224' height='144'/></clipPath>";

    function _paint(
        Seg memory o,
        bytes memory dir,
        uint8 skin,
        uint8[10] memory items,
        bytes memory open,
        bytes memory tail
    ) internal pure {
        _dyn(o, open);
        _dyn(o, bytes(PAINTED_OPEN));
        if (items[9] != 0) {
            _dyn(o, bytes(BG_OPEN));
            _put(o, _itemEl(dir, 10, items[9]));
            _dyn(o, "</g>");
        }
        bool front;
        if (items[8] != 0) {
            front = _flags(dir, 9, items[8]) & FRONT != 0;
            _dyn(o, "<defs>");
            _put(o, _itemEl(dir, 9, items[8]));
            _dyn(o, front ? abi.encodePacked(FRONT_CLIP, "</defs><use href='#a'/>") : bytes("</defs><use href='#a'/>"));
        }
        // the slots drawn as items, back to front: back, special, neck, hands, mouth, eyes, head
        uint8[7] memory order = [7, 8, 5, 6, 4, 3, 2];
        bool masked;
        for (uint256 i; i < 7; ++i) {
            uint256 k = order[i];
            if (items[k - 1] == 0) continue;
            uint256 e = _itemErase(dir, k, items[k - 1]);
            if (e == NONE) continue;
            if (!masked) _dyn(o, bytes(MASK_OPEN));
            masked = true;
            _put(o, e);
        }
        if (masked) _dyn(o, "</mask><g mask='url(#m)'>");
        _put(o, _u16(dir, OFF_SF + (uint256(skin) * 9 + items[0]) * 2));
        if (masked) _dyn(o, "</g>");
        if (front) _dyn(o, "<use href='#a' clip-path='url(#f)'/>");
        for (uint256 i; i < 7; ++i) {
            uint256 k = order[i];
            if (items[k - 1] != 0) _put(o, _itemEl(dir, k, items[k - 1]));
        }
        _dyn(o, "</g>");
        _dyn(o, tail);
    }

    /// prefix + base64(head) + each piece (dynamic: base64(base64(padded)), the last one base64(base64(it) + '"}');
    /// stored: copied as is)
    function _assemble(Seg memory o, bytes memory dir, bytes memory head) internal view returns (bytes memory out) {
        bytes memory h = bytes(CatchLib.base64(head));
        bytes[MAXSEG] memory enc;
        uint256 total = 29 + h.length;
        for (uint256 i; i < o.n; ++i) {
            if (o.id[i] == DYN) {
                bytes memory r = o.raw[i];
                if (i == o.n - 1) {
                    enc[i] = bytes(CatchLib.base64(abi.encodePacked(CatchLib.base64(r), '"}')));
                } else {
                    enc[i] = bytes(CatchLib.base64(bytes(CatchLib.base64(_pad9(r)))));
                }
                total += enc[i].length;
            } else {
                (, uint256 n) = _rec(dir, o.id[i]);
                total += n;
            }
        }
        uint256 p;
        (p, out) = _alloc(total);
        p = _write(p, "data:application/json;base64,");
        p = _write(p, h);
        for (uint256 i; i < o.n; ++i) {
            if (o.id[i] == DYN) {
                p = _write(p, enc[i]);
            } else {
                (uint256 start, uint256 n) = _rec(dir, o.id[i]);
                _copy(p, start, n);
                p += n;
            }
        }
    }

    function _pad9(bytes memory b) internal pure returns (bytes memory) {
        uint256 k = (9 - (b.length % 9)) % 9;
        if (k == 0) return b;
        return abi.encodePacked(b, _spaces(k));
    }

    function _spaces(uint256 k) internal pure returns (bytes memory s) {
        s = new bytes(k);
        for (uint256 i; i < k; ++i) {
            s[i] = " ";
        }
    }

    // ------------------------------------------------------------------ the directory

    function _readDir(address a) internal view returns (bytes memory d) {
        uint256 n = a.code.length;
        n = n == 0 ? 0 : n - 1;
        d = new bytes(n);
        assembly ("memory-safe") {
            extcodecopy(a, add(d, 0x20), 1, n)
        }
    }

    function _u8(bytes memory d, uint256 at) internal pure returns (uint256 v) {
        assembly ("memory-safe") {
            v := shr(248, mload(add(add(d, 0x20), at)))
        }
    }

    function _u16(bytes memory d, uint256 at) internal pure returns (uint256 v) {
        assembly ("memory-safe") {
            v := shr(240, mload(add(add(d, 0x20), at)))
        }
    }

    function _rec(bytes memory d, uint256 id) internal pure returns (uint256 start, uint256 n) {
        if (id >= ELEMENTS) revert ElementOutOfRange(id);
        assembly ("memory-safe") {
            let w := mload(add(add(d, 0x20), add(OFF_REC, mul(id, 6))))
            start := shr(232, w)
            n := and(shr(208, w), 0xffffff)
        }
    }

    function _slot(bytes memory d, uint256 k)
        internal
        pure
        returns (uint256 nU, uint256 nR, uint256 nE, uint256 nL, uint256 first)
    {
        uint256 at = OFF_SLOT + (k - 1) * 6;
        return (_u8(d, at), _u8(d, at + 1), _u8(d, at + 2), _u8(d, at + 3), _u16(d, at + 4));
    }

    /// the index in the item table of item `id` (1..n) of slot k
    function _itemIndex(bytes memory d, uint256 k, uint256 id) internal pure returns (uint256) {
        (uint256 nU, uint256 nR, uint256 nE, uint256 nL, uint256 first) = _slot(d, k);
        if (id == 0 || id > nU + nR + nE + nL) revert IdOutOfRange(id);
        return first + id - 1;
    }

    function _itemEl(bytes memory d, uint256 k, uint256 id) internal pure returns (uint256) {
        return _u16(d, OFF_ITEM + _itemIndex(d, k, id) * 8);
    }

    function _itemErase(bytes memory d, uint256 k, uint256 id) internal pure returns (uint256) {
        return _u16(d, OFF_ITEM + _itemIndex(d, k, id) * 8 + 2);
    }

    function _flags(bytes memory d, uint256 k, uint256 id) internal pure returns (uint256) {
        return _u8(d, OFF_ITEM + _itemIndex(d, k, id) * 8 + 4);
    }

    function _itemName(bytes memory d, uint256 i) internal pure returns (bytes memory) {
        uint256 at = OFF_ITEM + i * 8;
        return _slice(d, OFF_NAMES + _u16(d, at + 5), _u8(d, at + 7));
    }

    function _slice(bytes memory d, uint256 at, uint256 n) internal pure returns (bytes memory s) {
        s = new bytes(n);
        assembly ("memory-safe") {
            mcopy(add(s, 0x20), add(add(d, 0x20), at), n)
        }
    }

    // ------------------------------------------------------------------ memory

    function _alloc(uint256 n) internal pure returns (uint256 p, bytes memory b) {
        assembly ("memory-safe") {
            b := mload(0x40)
            mstore(b, n)
            p := add(b, 0x20)
            mstore(0x40, add(p, and(add(n, 63), not(31))))
        }
    }

    function _write(uint256 p, bytes memory s) internal pure returns (uint256) {
        uint256 n = s.length;
        assembly ("memory-safe") {
            mcopy(p, add(s, 0x20), n)
        }
        return p + n;
    }

    /// Copies stream bytes [start, start + n) to memory at dst, across chunk boundaries.
    function _copy(uint256 dst, uint256 start, uint256 n) internal view {
        while (n != 0) {
            uint256 k = start / CHUNK_BYTES;
            uint256 off = start - k * CHUNK_BYTES;
            uint256 take = CHUNK_BYTES - off;
            if (take > n) take = n;
            address a = _chunks[k];
            assembly ("memory-safe") {
                extcodecopy(a, dst, add(off, 1), take) // + 1: the INVALID byte
            }
            dst += take;
            start += take;
            n -= take;
        }
    }

    /// returns `out` as the ABI string result straight from where it lies (the word before it becomes the offset 0x20,
    /// the bytes after it are zeroed up to the next word: _alloc keeps that gap)
    function _ret(bytes memory out) internal pure {
        assembly ("memory-safe") {
            let n := mload(out)
            mstore(add(add(out, 0x20), n), 0)
            mstore(sub(out, 0x20), 0x20)
            return(sub(out, 0x20), add(0x40, and(add(n, 31), not(31))))
        }
    }
}
