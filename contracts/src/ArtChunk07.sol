pragma solidity 0.8.26;

/// Painted Quantum Catch art, data chunk 7 of 15 (0-based; generated by tools/pack_art.py from wheel/art/art.json, do
/// not edit). Its runtime code is one STOP byte, then 24,575 bytes of the base64 art stream (stream bytes
/// 172,025 to 196,599): it can never be called into; PaintedArt reads it with EXTCODECOPY.
contract ArtChunk07 {
    constructor() {
        bytes memory code = "\";
        assembly ("memory-safe") {
            return(add(code, 0x20), mload(code))
        }
    }
}
