pragma solidity 0.8.26;

/// Quantum Catch Season 2 art, data chunk 78 of 117 (0-based; generated by tools/pack_s2.py from
/// contracts/art/s2/sprites.json, do not edit). Its runtime code is one INVALID byte (0xfe: every call
/// and every ETH transfer to it reverts), then 24,575 bytes of the PRE2
/// element stream (stream bytes 1,916,850 to 1,941,424): it can never be called into; S2Renderer reads
/// it with EXTCODECOPY.
contract S2Art078 {
    constructor() {
        bytes memory code = "\";
        assembly ("memory-safe") {
            return(add(code, 0x20), mload(code))
        }
    }
}
