pragma solidity 0.8.26;

/// @title PaintedArt
/// @notice The painted Quantum Catch hamsters, fully on-chain: hamster(looks, tier) returns an SVG <g> fragment that draws
///         the hamster of a spot (looks = the spot's bits) in the skin of a tier, composed the way the Quantum Catch page
///         does it (wheel/page.template.html composite()), at its natural size of 448 x 600 user units.
/// @dev The 19 sprites the composite uses (body-<face>; skin-<tiger|circuit|crystal|gold>-<face>; fit-party, fit-glasses,
///      fit-scarf, each with its -erase and -shadow layer) are webp files, stored ALREADY BASE64-ENCODED (the exact
///      strings of wheel/art/art.json), so nothing is base64-encoded here. In asset-id order they form one stream; data
///      contract k (src/ArtChunkNN.sol) holds stream bytes [k * CHUNK_BYTES, (k + 1) * CHUNK_BYTES) after a STOP byte.
///      The constructor accepts only the packed chunks (each EXTCODEHASH is a constant below), in order. No owner, no
///      setters: the art can never change. tools/pack_art.py packs the art, writes the generated block below and holds
///      the reference renderer this contract must match byte for byte (test/PaintedArt.t.sol).
///
///      The fragment: face = bit 3 (grin, else honey). Base = body-<face> for tier 0 (not caught: the page's plain look)
///      and 1 (Common); skin-tiger / circuit / crystal / gold-<face> for tier 2 / 3 / 4 / 5 (Uncommon .. Legendary).
///      Worn items, in the page's order: bit 2 scarf, bit 1 glasses, bit 0 party hat. Every worn item's -erase layer is
///      cut out of the base by a luminance <mask> (a white rect with the erase layers drawn over it: they are pure black
///      where not transparent, so the mask is 1 - alpha, exactly the page's destination-out), then for each item its
///      -shadow and the item. Every <image> is 448 x 600 at (0, 0). All attributes are single-quoted, so the fragment
///      has no double quote or backslash (it can sit inside a JSON string as is); the mask id is qh<looks>_<tier>.
contract PaintedArt {
    error LooksOutOfRange(uint8 looks);
    error TierOutOfRange(uint8 tier);
    error AssetOutOfRange(uint256 id);
    error WrongChunkCount(uint256 count);
    error WrongChunk(uint256 k, address chunk);

    /// @notice the fragment's size in user units (every layer is this size, at the origin)
    uint256 public constant WIDTH = 448;
    uint256 public constant HEIGHT = 600;
    /// @notice stream bytes per data contract (its runtime is a STOP byte and then these: 24,576 bytes, the EIP-170 cap)
    uint256 public constant CHUNK_BYTES = 24575;

    // asset ids of the items (the item, then its -erase, then its -shadow)
    uint256 internal constant PARTY = 10;
    uint256 internal constant GLASSES = 13;
    uint256 internal constant SCARF = 16;

    // ---- generated by tools/pack_art.py from wheel/art/art.json: do not edit by hand ----
    /// @notice data contracts holding the art stream (360,440 bytes of base64 webp)
    uint256 public constant CHUNKS = 15;
    /// @notice sprites in the stream (ids: 0..1 bodies, 2..9 skins, 10..18 items with their -erase, -shadow)
    uint256 public constant ASSETS = 19;
    /// @dev per asset id: uint24 start, uint24 length in the stream
    bytes internal constant INDEX = hex"000000005aa4005aa4005ec400b968007b600134c800754001aa08008518022f2000887c02b79c006f9c032738007c1003a348007400041748006fb40486fc001cac04a3a8000ae004ae880018d404c75c0027dc04ef380007c804f7000010400507400048d0055010000658055668002990";
    /// @dev per chunk: keccak256 of its runtime code (STOP + its stream bytes), checked by the constructor
    bytes internal constant CODEHASHES =
        hex"de781e9298c38bd76c7d801f10b0f2974c65fc6030df95ee739c9065404741a4"
        hex"6d070472684941916c6665b369cc2b5653a5bfa49f3687e53e1ae60d671a39c0"
        hex"c695d60b59c2e594d1a62b2f8be6e715b42a1d18b33c599beab580d94966c897"
        hex"5af8da289b196a00bc3d3aee40fcccab81a8afe027b02c24dfbe22a221c1b1f1"
        hex"225a87706e47e11ff57cb249440c9390a55b798d2712fe5c2c7a0f95258b22c8"
        hex"3902a6f8a4a08da3f20a5bbbe36fcb2feb31dd9f2879a363a9adcbbd2cd9e61d"
        hex"785775ffb8f6f001218ffedacad33323f3b5463734531ed2c27afadf57f462ea"
        hex"069f03d405970c7a61d3a188448dd454ff3cb0619b0cafbe3ba0db61ac13c02b"
        hex"5c02f88958948b068ebb0daccf499f111b0d77d1757d474484230950c6425f30"
        hex"02787d73df64e8dd97f290b208041009ee5f657c3e00da7d9530aa4391942bcf"
        hex"6149aa0d1b8419800dc2bda0c17177ceeb875ebf8dcb49278e0d60330902bd41"
        hex"a89c2d48eb90bbb0d3c07aab4929d50c65a1c8709b92b7f2d0667c1694c31fb7"
        hex"eb36a576c04084fe53b1e99d85e89ea3f363f192d4865d4d71dbbd7685f18b97"
        hex"36410ef38f57a929d3ac59a2c2a5248969f8b237adf3a2ba3c6fb2ad22058c2a"
        hex"aae0db13abbcc48306acc3d9dd9b5de5c08ee455b274014f44fd2b4145c9427b";
    // ---- end of generated block ----

    address[] private _chunks;

    /// @param chunks_ the deployed ArtChunk00 .. ArtChunkNN data contracts, in order
    constructor(address[] memory chunks_) {
        if (chunks_.length != CHUNKS) revert WrongChunkCount(chunks_.length);
        bytes memory hashes = CODEHASHES;
        for (uint256 k = 0; k < CHUNKS; k++) {
            address a = chunks_[k];
            bytes32 want;
            assembly ("memory-safe") {
                want := mload(add(add(hashes, 0x20), shl(5, k)))
            }
            if (a.codehash != want) revert WrongChunk(k, a);
            _chunks.push(a);
        }
    }

    /// @notice the SVG <g> fragment of the hamster with these looks (0..15: bit 0 party hat, bit 1 glasses, bit 2
    ///         scarf, bit 3 grin) in the skin of this tier (1 Common .. 5 Legendary; 0 = not caught, drawn plain like
    ///         Common), 448 x 600 user units at the origin, painted webp layers as data URIs
    function hamster(uint8 looks, uint8 tier) external view returns (string memory svgGroup) {
        if (looks > 15) revert LooksOutOfRange(looks);
        if (tier > 5) revert TierOutOfRange(tier);
        bytes memory index = INDEX;
        uint256 len = _draw(0, false, looks, tier, index);
        bytes memory out = new bytes(len);
        uint256 p;
        assembly ("memory-safe") {
            p := add(out, 0x20)
        }
        assert(_draw(p, true, looks, tier, index) == p + len);
        svgGroup = string(out);
    }

    /// @notice one sprite's base64 webp string (asset ids: 0..1 body-honey, body-grin; 2..9 skin-tiger, -circuit,
    ///         -crystal, -gold, each honey then grin; 10..18 fit-party, fit-glasses, fit-scarf, each item, -erase, -shadow)
    function asset(uint256 id) external view returns (string memory b64) {
        (uint256 start, uint256 n) = _span(INDEX, id);
        bytes memory out = new bytes(n);
        uint256 p;
        assembly ("memory-safe") {
            p := add(out, 0x20)
        }
        _copy(p, start, n);
        b64 = string(out);
    }

    /// @notice where a sprite sits in the stream
    function assetSpan(uint256 id) external pure returns (uint256 start, uint256 length) {
        return _span(INDEX, id);
    }

    /// @notice the data contracts, in stream order
    function chunks() external view returns (address[] memory) {
        return _chunks;
    }

    // ---------------------------------------------------------------- drawing

    /// Writes the fragment at p when `write` (else only measures it); returns the end.
    function _draw(uint256 p, bool write, uint8 looks, uint8 tier, bytes memory index) private view returns (uint256) {
        uint256 face = (looks >> 3) & 1;
        uint256 base = tier <= 1 ? face : 2 * (uint256(tier) - 1) + face;
        uint256[3] memory fits;
        uint256 k;
        if (looks & 4 != 0) fits[k++] = SCARF;
        if (looks & 2 != 0) fits[k++] = GLASSES;
        if (looks & 1 != 0) fits[k++] = PARTY;

        p = _put(p, write, "<g>");
        if (k == 0) {
            p = _image(p, write, base, index);
        } else {
            bytes memory id = _id(looks, tier);
            p = _put(p, write, "<mask id='");
            p = _put(p, write, id);
            p = _put(
                p,
                write,
                "' maskUnits='userSpaceOnUse' maskContentUnits='userSpaceOnUse' x='0' y='0' width='448' height='600' "
                "color-interpolation='sRGB'><rect width='448' height='600' fill='#fff'/>"
            );
            for (uint256 i = 0; i < k; i++) {
                p = _image(p, write, fits[i] + 1, index); // -erase
            }
            p = _put(p, write, "</mask><image width='448' height='600' mask='url(#");
            p = _put(p, write, id);
            p = _put(p, write, ")' href='data:image/webp;base64,");
            p = _asset(p, write, base, index);
            p = _put(p, write, "'/>");
            for (uint256 i = 0; i < k; i++) {
                p = _image(p, write, fits[i] + 2, index); // -shadow
                p = _image(p, write, fits[i], index); // the item
            }
        }
        return _put(p, write, "</g>");
    }

    function _image(uint256 p, bool write, uint256 id, bytes memory index) private view returns (uint256) {
        p = _put(p, write, "<image width='448' height='600' href='data:image/webp;base64,");
        p = _asset(p, write, id, index);
        return _put(p, write, "'/>");
    }

    /// "qh<looks>_<tier>"
    function _id(uint8 looks, uint8 tier) private pure returns (bytes memory) {
        bytes memory l = looks < 10 ? abi.encodePacked(bytes1(uint8(48 + looks))) : abi.encodePacked("1", bytes1(uint8(38 + looks)));
        return abi.encodePacked("qh", l, "_", bytes1(uint8(48 + tier)));
    }

    function _put(uint256 p, bool write, bytes memory s) private pure returns (uint256) {
        uint256 n = s.length;
        if (write) {
            assembly ("memory-safe") {
                mcopy(p, add(s, 0x20), n)
            }
        }
        return p + n;
    }

    function _asset(uint256 p, bool write, uint256 id, bytes memory index) private view returns (uint256) {
        (uint256 start, uint256 n) = _span(index, id);
        if (write) _copy(p, start, n);
        return p + n;
    }

    function _span(bytes memory index, uint256 id) private pure returns (uint256 start, uint256 n) {
        if (id >= ASSETS) revert AssetOutOfRange(id);
        assembly ("memory-safe") {
            let w := mload(add(add(index, 0x20), mul(id, 6)))
            start := shr(232, w)
            n := and(shr(208, w), 0xffffff)
        }
    }

    /// Copies stream bytes [start, start + n) to memory at dst, across chunk boundaries.
    function _copy(uint256 dst, uint256 start, uint256 n) private view {
        while (n != 0) {
            uint256 k = start / CHUNK_BYTES;
            uint256 off = start - k * CHUNK_BYTES;
            uint256 take = CHUNK_BYTES - off;
            if (take > n) take = n;
            address a = _chunks[k];
            assembly ("memory-safe") {
                extcodecopy(a, dst, add(off, 1), take) // + 1: the STOP byte
            }
            dst += take;
            start += take;
            n -= take;
        }
    }
}
