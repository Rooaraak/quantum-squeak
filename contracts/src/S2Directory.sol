pragma solidity 0.8.26;

/// Quantum Catch Season 2 art directory (generated by tools/pack_s2.py from contracts/art/s2/sprites.json, do not
/// edit): 6,914 bytes after an INVALID byte (0xfe: every call and ETH transfer reverts). The art chunks' code hashes, the element records, the trait tables
/// and the names (layout: tools/pack_s2.py, S2Renderer's generated constants). It can never be called into; S2Renderer
/// reads it with EXTCODECOPY.
contract S2Directory {
    constructor() {
        bytes memory code = hex"";
        assembly ("memory-safe") {
            return(add(code, 0x20), mload(code))
        }
    }
}
