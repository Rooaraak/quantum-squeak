pragma solidity 0.8.26;

/// Painted Quantum Catch art, data chunk 14 of 15 (0-based; generated by tools/pack_art.py from wheel/art/art.json, do
/// not edit). Its runtime code is one STOP byte, then 16,390 bytes of the base64 art stream (stream bytes
/// 344,050 to 360,439): it can never be called into; PaintedArt reads it with EXTCODECOPY.
contract ArtChunk14 {
    constructor() {
        bytes memory code = "\";
        assembly ("memory-safe") {
            return(add(code, 0x20), mload(code))
        }
    }
}
